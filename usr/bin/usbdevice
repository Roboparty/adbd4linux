#!/bin/sh -e
# SPDX-License-Identifier: GPL-3.0
# Copyright (C) 2026 wentywenty
#
# usbdevice -- generic USB gadget bring-up for adbd, using configfs + FunctionFS.
#
# Board-agnostic: it binds to the first available USB Device Controller (UDC).
# When no UDC exists (e.g. the port is in host mode) it is a harmless no-op, so
# the associated service can be enabled unconditionally.
#
# Usage: usbdevice start|stop|status|restart
#
# Overridable defaults live in /etc/default/adbd-gadget.

CONFIGFS=/sys/kernel/config
GADGET_DIR="${CONFIGFS}/usb_gadget"
FFS_MOUNTPOINT=/dev/usb-ffs/adb   # adbd expects its FunctionFS ep0 exactly here
DEFAULTS=/etc/default/adbd-gadget
ADBD=/usr/bin/adbd

if [ -r "${DEFAULTS}" ]; then
	# shellcheck disable=SC1090
	. "${DEFAULTS}"
fi

GADGET_NAME="${ADBD_GADGET_NAME:-adbd}"
G="${GADGET_DIR}/${GADGET_NAME}"
NCM_FUNCTION="${ADBD_GADGET_NCM_FUNCTION:-ncm.usb0}"

NET_MODE="${ADBD_GADGET_NET:-none}"
case "${NET_MODE}" in
	none|ncm) ;;
	*)
		echo "usbdevice: unsupported ADBD_GADGET_NET=${NET_MODE}" >&2
		exit 1
		;;
esac

idVendor="${ADBD_GADGET_IDVENDOR:-0x18d1}"   # Google
idProduct="${ADBD_GADGET_IDPRODUCT:-0x4ee7}" # Google ADB interface
bcdDevice="${ADBD_GADGET_BCDDEVICE:-0x0100}"

dt_string() {
	for root in /proc/device-tree /sys/firmware/devicetree/base; do
		if [ -r "${root}/$1" ]; then
			tr -d '\000' < "${root}/$1"
			return 0
		fi
	done
	return 1
}

default_serial() {
	if s=$(dt_string serial-number) && [ -n "${s}" ]; then
		printf '%s\n' "${s}"
	elif [ -r /etc/machine-id ]; then
		cat /etc/machine-id
	else
		printf '0123456789\n'
	fi
}

# Identity comes from the device tree (the board itself) when available; there
# is no invented vendor name. "Linux Foundation" is the standard USB gadget
# manufacturer used by the kernel's own gadget examples.
manufacturer="${ADBD_GADGET_MANUFACTURER:-$(dt_string manufacturer || dt_string model || printf 'Linux Foundation')}"
product="${ADBD_GADGET_PRODUCT:-ADB Interface}"
serialnumber="${ADBD_GADGET_SERIAL:-$(default_serial)}"

first_udc() {
	for udc in /sys/class/udc/*; do
		[ -e "${udc}" ] || return 0
		printf '%s\n' "${udc##*/}"
		return 0
	done
}

adbd_start() {
	pidof adbd >/dev/null 2>&1 && return 0
	shell=${ADBD_SHELL:-}
	if [ -z "${shell}" ]; then
		shell=$(command -v bash 2>/dev/null || true)
		[ -n "${shell}" ] || shell=/bin/sh
	fi
	ADBD_SHELL="${shell}" ADBD_GADGET_UDC_PATH="${G}/UDC" \
		ADBD_GADGET_UDC="${udc}" setsid "${ADBD}" >/tmp/adbd.log 2>&1 &
}

adbd_stop() {
	pkill -x adbd >/dev/null 2>&1 || true
	# Let the daemon exit before tearing down configfs, so a reconnect cannot
	# race the intentional unbind performed by stop/restart.
	remaining=50
	while pidof adbd >/dev/null 2>&1; do
		[ "${remaining}" -gt 0 ] || {
			echo "usbdevice: adbd did not stop; leaving gadget intact" >&2
			return 1
		}
		sleep 0.1
		remaining=$((remaining - 1))
	done
}

ffs_mount() {
	mkdir -p "${FFS_MOUNTPOINT}"
	mountpoint -q "${FFS_MOUNTPOINT}" && return 0
	ffs_uid=${ADBD_GADGET_FFS_UID:-$(id -u)}
	ffs_gid=${ADBD_GADGET_FFS_GID:-$(id -g)}
	case ${ffs_uid} in
		''|*[!0-9]*) echo "usbdevice: invalid ADBD_GADGET_FFS_UID" >&2; return 1 ;;
	esac
	case ${ffs_gid} in
		''|*[!0-9]*) echo "usbdevice: invalid ADBD_GADGET_FFS_GID" >&2; return 1 ;;
	esac
	mount -t functionfs adb "${FFS_MOUNTPOINT}" -o "uid=${ffs_uid},gid=${ffs_gid}"
}

ffs_umount() {
	mountpoint -q "${FFS_MOUNTPOINT}" || return 0
	umount "${FFS_MOUNTPOINT}" || {
		echo "usbdevice: FunctionFS is busy; leaving gadget intact" >&2
		return 1
	}
}

net_prepare() {
	[ "${NET_MODE}" = ncm ] || return 0

	if command -v modprobe >/dev/null 2>&1; then
		modprobe usb_f_ncm 2>/dev/null || true
	fi

	# The CDC-NCM function is composed with adb in the same configuration.
	mkdir -p "${G}/functions/${NCM_FUNCTION}"
	rm -f "${G}/configs/c.1/${NCM_FUNCTION}"
	ln -s "${G}/functions/${NCM_FUNCTION}" "${G}/configs/c.1/${NCM_FUNCTION}"
}

gadget_start() {
	udc=$(first_udc)
	if [ -z "${udc}" ]; then
		echo "usbdevice: no USB Device Controller; nothing to do"
		return 0
	fi

	[ -d "${CONFIGFS}" ] || {
		echo "usbdevice: configfs not available" >&2
		return 1
	}

	# The gadget may be installed before the modules-load unit has run.
	if command -v modprobe >/dev/null 2>&1; then
		modprobe libcomposite 2>/dev/null || true
		modprobe usb_f_fs 2>/dev/null || true
	fi

	if [ -d "${G}" ] && [ -n "$(cat "${G}/UDC" 2>/dev/null)" ]; then
		echo "usbdevice: gadget already bound"
		return 0
	fi

	# Clean partial setup on any error, preserving the original exit status.
	trap 'rc=$?; trap - EXIT; set +e; if [ "${rc}" -ne 0 ]; then gadget_stop; fi; exit "${rc}"' EXIT
	trap 'exit 1' HUP INT TERM

	mkdir -p "${G}"
	echo "${idVendor}" > "${G}/idVendor"
	echo "${idProduct}" > "${G}/idProduct"
	echo "${bcdDevice}" > "${G}/bcdDevice"
	echo 0x0200 > "${G}/bcdUSB"

	# A composite gadget must use the multi-interface device class on Windows,
	# otherwise Windows treats it as a single function.
	if [ "${NET_MODE}" = ncm ]; then
		echo 0xef > "${G}/bDeviceClass"
		echo 0x02 > "${G}/bDeviceSubClass"
		echo 0x01 > "${G}/bDeviceProtocol"
	fi

	mkdir -p "${G}/strings/0x409"
	echo "${manufacturer}" > "${G}/strings/0x409/manufacturer"
	echo "${product}" > "${G}/strings/0x409/product"
	echo "${serialnumber}" > "${G}/strings/0x409/serialnumber"

	mkdir -p "${G}/configs/c.1/strings/0x409"
	echo 500 > "${G}/configs/c.1/MaxPower"
	if [ "${NET_MODE}" = ncm ]; then
		echo "ADB + NCM" > "${G}/configs/c.1/strings/0x409/configuration"
	else
		echo "ADB" > "${G}/configs/c.1/strings/0x409/configuration"
	fi

	mkdir -p "${G}/functions/ffs.adb"
	ffs_mount
	net_prepare
	rm -f "${G}/configs/c.1/ffs.adb"
	ln -s "${G}/functions/ffs.adb" "${G}/configs/c.1/ffs.adb"
	adbd_start

	# adbd binds after writing descriptors and opening the endpoints, including
	# every reopen after a disconnect. Only one process writes the binding.
	remaining=100
	bound=no
	while [ "${remaining}" -gt 0 ]; do
		if [ "$(cat "${G}/UDC" 2>/dev/null)" = "${udc}" ]; then
			bound=yes
			break
		fi
		sleep 0.1
		remaining=$((remaining - 1))
	done
	if [ "${bound}" != yes ]; then
		echo "usbdevice: timed out waiting for FunctionFS/configfs bind" >&2
		exit 1
	fi
	echo "usbdevice: bound to ${udc}"
	trap - EXIT HUP INT TERM
}

gadget_stop() {
	adbd_stop || return 1
	if [ -d "${G}" ]; then
		echo "" > "${G}/UDC" 2>/dev/null || true
		# Release the mount before deleting its associated function instance.
		ffs_umount || return 1
		rm -f "${G}/os_desc/c.1"
		rm -f "${G}/configs/c.1/ffs.adb"
		rm -f "${G}/configs/c.1/${NCM_FUNCTION}"
		rmdir "${G}/functions/${NCM_FUNCTION}" 2>/dev/null || true
		rmdir "${G}/configs/c.1/strings/0x409" 2>/dev/null || true
		rmdir "${G}/configs/c.1" 2>/dev/null || true
		rmdir "${G}/functions/ffs.adb" 2>/dev/null || true
		rmdir "${G}/strings/0x409" 2>/dev/null || true
		rmdir "${G}" 2>/dev/null || true
	fi
	ffs_umount || return 1
	echo "usbdevice: stopped"
}

gadget_status() {
	if [ -d "${G}" ] && [ -n "$(cat "${G}/UDC" 2>/dev/null)" ]; then
		echo "usbdevice: active (udc=$(cat "${G}/UDC"))"
	else
		echo "usbdevice: inactive"
	fi
}

case "${1:-status}" in
	start)
		gadget_start
		;;
	stop)
		gadget_stop
		;;
	restart)
		gadget_stop
		gadget_start
		;;
	status)
		gadget_status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 1
		;;
esac
