# Configuration for the USB ADB gadget (usbdevice / adbd).
# Sourced by /usr/bin/usbdevice. All values are optional.

# USB identity. Defaults use Google's adb vendor/product IDs so that host adb
# and common udev rules recognise the device out of the box.
ADBD_GADGET_IDVENDOR=0x18d1
ADBD_GADGET_IDPRODUCT=0x4ee7

# Gadget/configfs directory name.
ADBD_GADGET_NAME=adbd

# Device revision (bcdDevice).
ADBD_GADGET_BCDDEVICE=0x0100

# USB strings and serial number. When unset, the manufacturer is read from the
# device tree (board), the product defaults to "ADB Interface", and the serial
# from the device tree or /etc/machine-id.
#ADBD_GADGET_MANUFACTURER=Linux Foundation
#ADBD_GADGET_PRODUCT=ADB Interface
#ADBD_GADGET_SERIAL=0123456789

# FunctionFS mount ownership. Defaults to the user running usbdevice, or to
# ADBD_USER when that is set.
#ADBD_GADGET_FFS_UID=0
#ADBD_GADGET_FFS_GID=0

# adbd runtime. "auto" runs adbd (and adb shell) as the first regular account
# (uid 1000+, valid login shell); set a name to pick one explicitly. Leave
# empty to run adbd as root. Gadget setup stays root either way, and FunctionFS
# ownership follows the selected user.
ADBD_USER=auto

# Extra network transports. USB is used automatically when a UDC exists.
# tcp:<port> listens on all interfaces; tcp:127.0.0.1:<port> is loopback only.
# These reach adbd, so keep the export keyword.
#export ADBD_LISTEN=tcp:5555
#export ADBD_PORT=5555

# Optional CDC-NCM function, composed with adb in the same USB configuration.
# Windows 10/11, Linux and macOS see a USB Ethernet adapter; the usbnetwork
# service configures usb0, DHCP and NAT when this is enabled.
# USB networking (and its DHCP/NAT "internet sharing") is disabled by default.
ADBD_GADGET_NET=none
#ADBD_GADGET_NCM_FUNCTION=ncm.usb0

# USB network settings used by /usr/bin/usbnetwork.
#ADBD_USBNET_IFACE=usb0
#ADBD_USBNET_ADDRESS=192.168.42.1
#ADBD_USBNET_PREFIX=24
#ADBD_USBNET_NETWORK=192.168.42.0/24
#ADBD_USBNET_DHCP_START=192.168.42.100
#ADBD_USBNET_DHCP_END=192.168.42.200
#ADBD_USBNET_DNS=1.1.1.1
#ADBD_USBNET_UPLINK=end0
